{
  "name": "simulador-eletrico2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:standalone": "vite build && node -e \"require('fs').mkdirSync('standalone',{recursive:true});require('fs').copyFileSync('dist/index.html','standalone/simulador.html')\"",
    "build:replay": "vite build --mode replay --outDir dist/replay && node -e \"require('fs').mkdirSync('standalone',{recursive:true});require('fs').copyFileSync('dist/replay/index.html','standalone/genco-replay.html')\"",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "d3": "^7.9.0",
    "dagre": "^0.8.5",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "save-svg-as-png": "^1.4.17"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
